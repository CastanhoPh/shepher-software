{
  "name": "alianca-backend",
  "version": "2.0.0",
  "description": "Backend do Sistema de Gestão Aliança — Cloud Function servida pelo Firebase Hosting em /api",
  "main": "dist/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child -r tsconfig-paths/register src/server.ts",
    "build": "tsc && tsc-alias",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "serve": "npm run build && firebase emulators:start --only functions,hosting",
    "logs": "firebase functions:log --only api",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "igreja",
    "gestao",
    "g12"
  ],
  "author": "Sistema Aliança",
  "license": "MIT",
  "dependencies": {
    "busboy": "^1.6.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.5.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
