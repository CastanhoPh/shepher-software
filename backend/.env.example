# ============================================================================
# Credenciais para DESENVOLVIMENTO LOCAL apenas.
#
# Copie este arquivo para `.env.dev` (NAO para `.env`) e preencha os valores.
#
# Por que `.env.dev`?
#   O Firebase CLI carrega automaticamente o `.env` da pasta de functions e
#   transforma cada chave em variavel de ambiente da function. Chaves com
#   prefixo FIREBASE_ sao RESERVADAS pelo runtime e fazem o deploy falhar.
#   O `.env.dev` e carregado explicitamente por src/config/env.ts e ignorado
#   pelo Firebase CLI.
#
# Em PRODUCAO nada disso e necessario: a Cloud Function autentica no
# Firestore/Auth pela service account do proprio projeto (ADC).
# ============================================================================

NODE_ENV=development
PORT=3000

# Origens extras permitidas no CORS, separadas por virgula.
# Os dominios do Hosting (<projeto>.web.app / .firebaseapp.com) e o localhost
# do Vite ja sao liberados automaticamente.
ALLOWED_ORIGINS=http://localhost:5173

# Service account (Console do Firebase > Configuracoes do projeto > Contas de
# servico > Gerar nova chave privada)
ADMIN_PROJECT_ID=
ADMIN_CLIENT_EMAIL=
# Mantenha entre aspas e com os \n escapados, em uma unica linha
ADMIN_PRIVATE_KEY=""

# Web API key do projeto (Console > Configuracoes do projeto > Geral).
# Usada pelo login email/senha via REST do Firebase Auth.
WEB_API_KEY=

# Limite de requisicoes
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_LOGIN_MAX_REQUESTS=5
